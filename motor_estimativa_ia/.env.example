# Copie para .env e ajuste os valores.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Caracteres especiais da senha devem ser codificados na URL (ex.: "@" -> %40).
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/BANCO
DATABASE_URL_TEST=postgresql+psycopg://USUARIO:SENHA@localhost:5432/BANCO_test

# UNE AI SSO (autenticação). A base é a raiz do serviço; /api é só o Swagger UI.
SSO_BASE_URL=http://localhost:4000
SSO_DOMAIN_SLUG=motor-estimativa
SSO_TIMEOUT_SECONDS=5
# Cache da validação do token (GET /users/me); 0 desliga.
SSO_CACHE_TTL_SECONDS=30
# Tokens com vida maior que isto são recusados como Bearer (o refresh token do SSO dura 7 dias).
SSO_MAX_TOKEN_LIFETIME_SECONDS=3660

# Decomposição assistida por IA (OpenAI). Sem chave, só a sugestão por IA fica indisponível.
# OPENAI_API_KEY=
# ESTIMATION_AI_MODEL=gpt-5.5
# ESTIMATION_AI_EFFORT=medium
